# Etherscan key for the server-side chain proxy and App Engine mint sync.
# Set this in:
#   - Vercel → Project → Settings → Environment Variables (Production + Preview)
#   - GCP → App Engine → Settings → Environment variables (image API / local Flask)
# Do NOT prefix it with REACT_APP_. That prefix is inlined into the browser bundle.
# Remove REACT_APP_ETHERSCAN_API_KEY from Vercel if it is still set.
ETHERSCAN_API_KEY=

# Frontend local dev: copy vars below to frontend/.env.development (gitignored) for `npm start`
REACT_APP_API_URL=http://localhost:5000
# REACT_APP_DEBUG=true
# Optional override for the chain proxy origin. Leave unset in production so the
# browser calls same-origin /api/chain/* (Vercel). Local `npm start` proxies
# /api/* to the Flask app, which reads ETHERSCAN_API_KEY.
# REACT_APP_CHAIN_PROXY_URL=

# Frontend local prod build (optional): copy to frontend/.env.production.local (gitignored)
# or use `npm run build:local` with frontend/.env.production (gitignored).
# Vercel: set these in Project Settings → Environment Variables (Production + Preview).
# Do not commit secret values; `npm run build` reads REACT_APP_* from the environment.
#
# Required on Vercel (serverless, secret — not exposed to the client):
# ETHERSCAN_API_KEY=<your Etherscan API key>
#
# Recommended on Vercel (public backend URL):
# REACT_APP_API_URL=https://afa-editor.ew.r.appspot.com
#
# Optional:
# REACT_APP_DEBUG=false
